# API
DATABASE_URL=postgresql+psycopg://secopsai:secopsai@127.0.0.1:5432/secopsai_edge
SECOPSAI_ADMIN_TOKEN=dev-admin-token
SECOPSAI_TOKEN_SECRET=change-me-before-pilot
SECOPSAI_DASHBOARD_ADMIN_EMAIL=
SECOPSAI_DASHBOARD_ADMIN_PASSWORD=
SECOPSAI_DASHBOARD_SESSION_TTL_SECONDS=28800
SECOPSAI_AUTO_CREATE_TABLES=false
SECOPSAI_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# AI reporting
AI_PROVIDER=mock
AI_ENDPOINT=
AI_API_KEY=
AI_MODEL=gpt-5.4-mini

# Splunk HEC export
SPLUNK_HEC_ENABLED=false
SPLUNK_HEC_URL=
SPLUNK_HEC_TOKEN=

# Web
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_EDGE_ROOT=$HOME/secopsai-edge
NEXT_PUBLIC_CORE_ROOT=$HOME/secopsai
