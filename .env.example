# API
DATABASE_URL=postgresql+psycopg://secopsai:secopsai@127.0.0.1:5432/secopsai_edge
SECOPSAI_DATABASE_CONNECT_TIMEOUT_SECONDS=3
SECOPSAI_DATABASE_POOL_TIMEOUT_SECONDS=3
SECOPSAI_DATABASE_STATEMENT_TIMEOUT_MS=3000
SECOPSAI_ENVIRONMENT=development
SECOPSAI_RELEASE_VERSION=0.3.0
SECOPSAI_RELEASE_COMMIT=local
SECOPSAI_ADMIN_TOKEN=dev-admin-token
SECOPSAI_TOKEN_SECRET=change-me-before-pilot
SECOPSAI_DASHBOARD_ADMIN_EMAIL=
SECOPSAI_DASHBOARD_ADMIN_PASSWORD=
SECOPSAI_DASHBOARD_SESSION_TTL_SECONDS=28800
SECOPSAI_LOGIN_MAX_ATTEMPTS=5
SECOPSAI_LOGIN_LOCKOUT_SECONDS=900
SECOPSAI_DASHBOARD_RESET_URL=http://127.0.0.1:3000/settings
SECOPSAI_DASHBOARD_INVITE_URL=http://127.0.0.1:3000/settings
SECOPSAI_PASSWORD_RESET_TTL_SECONDS=1800
SECOPSAI_PASSWORD_RESET_COOLDOWN_SECONDS=60
SECOPSAI_PASSWORD_RESET_MAX_DELIVERY_ATTEMPTS=4
SECOPSAI_PASSWORD_RESET_BATCH_SIZE=25
SECOPSAI_INVITATION_TTL_SECONDS=86400
SECOPSAI_MFA_CHALLENGE_TTL_SECONDS=300
SECOPSAI_MFA_SETUP_TTL_SECONDS=600
SECOPSAI_MFA_ENCRYPTION_KEY=change-me-before-pilot-with-a-random-32-character-key
SECOPSAI_WEBHOOK_SIGNING_SECRET=change-me-before-pilot
SECOPSAI_NOTIFICATION_MAX_ATTEMPTS=4
SECOPSAI_NOTIFICATION_BATCH_SIZE=50
SECOPSAI_AUTO_CREATE_TABLES=false
SECOPSAI_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# AI reporting
AI_PROVIDER=mock
AI_ENDPOINT=
AI_API_KEY=
AI_MODEL=gpt-5.4-mini

# Splunk HEC export
SPLUNK_HEC_ENABLED=false
SPLUNK_HEC_URL=
SPLUNK_HEC_TOKEN=

# Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=alerts@secopsai.local
TELEGRAM_BOT_TOKEN=

# Web
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_EDGE_ROOT=$HOME/secopsai-edge
NEXT_PUBLIC_CORE_ROOT=$HOME/secopsai
