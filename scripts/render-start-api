#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

alembic -c api/alembic.ini upgrade head

exec uvicorn secopsai_api.main:app \
  --app-dir api \
  --host 0.0.0.0 \
  --port "${PORT:-8000}" \
  --proxy-headers \
  --forwarded-allow-ips="*" \
  --no-server-header \
  --limit-concurrency 100 \
  --limit-max-requests 10000 \
  --timeout-graceful-shutdown 30
