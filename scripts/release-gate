#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PYTHON_BIN="$ROOT_DIR/.venv/bin/python"
ALEMBIC_BIN="$ROOT_DIR/.venv/bin/alembic"

cd "$ROOT_DIR"
git diff --check
if ! git diff --quiet || ! git diff --cached --quiet; then
  echo "Release gate requires a clean committed worktree" >&2
  exit 1
fi
bash -n scripts/edge scripts/install-secopsai-edge.sh scripts/bootstrap-secopsai-edge.sh scripts/build-release scripts/database-backup scripts/render-postgres-backup scripts/render-start-api
python3 -m py_compile scripts/render-run-due-schedules scripts/render_drift_check.py scripts/render_psql_backup_proxy.py scripts/core-sync-runner.py scripts/hosted_health_check.py scripts/pilot_acceptance.py

[ -x "$PYTHON_BIN" ] || { echo "Run ./scripts/edge setup first" >&2; exit 1; }
[ -x "$ALEMBIC_BIN" ] || { echo "Alembic is not installed in .venv" >&2; exit 1; }

heads="$(PYTHONPATH=api "$ALEMBIC_BIN" -c api/alembic.ini heads | awk '{print $1}')"
[ "$heads" = "0016_wifi_provenance" ] || {
  echo "Unexpected Alembic head: $heads" >&2
  exit 1
}

for forbidden in .env .sensor.env .cloud.env .cloud-sensor.env; do
  if git ls-files --error-unmatch "$forbidden" >/dev/null 2>&1; then
    echo "Tracked credential file detected: $forbidden" >&2
    exit 1
  fi
done

PYTHONPATH=api:agent "$PYTHON_BIN" -m compileall -q api/secopsai_api agent/secopsai_agent
./scripts/edge test

release_dir="$(mktemp -d "${TMPDIR:-/tmp}/secopsai-edge-release.XXXXXX")"
trap 'rm -rf "$release_dir"' EXIT
release_version="$(PYTHONPATH=api "$PYTHON_BIN" -c 'from secopsai_api import __version__; print(__version__)')"
./scripts/build-release "$release_version" "$release_dir" >/dev/null
(
  cd "$release_dir"
  shasum -a 256 -c "secopsai-edge-$release_version.tar.gz.sha256"
)
archive_listing="$(tar -tzf "$release_dir/secopsai-edge-$release_version.tar.gz")"
for required in scripts/edge scripts/install-secopsai-edge.sh agent/secopsai_agent/__init__.py requirements.lock; do
  printf "%s\n" "$archive_listing" | grep -q "/$required$" || {
    echo "Release archive is missing $required" >&2
    exit 1
  }
done
if printf "%s\n" "$archive_listing" | grep -Eq '/(\.env|\.cloud\.env|\.cloud-sensor\.env|\.sensor\.env|node_modules|\.venv)(/|$)'; then
  echo "Release archive contains a forbidden credential/build path" >&2
  exit 1
fi

echo "Release gate passed at $(git rev-parse --short HEAD)"
