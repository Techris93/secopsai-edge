#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import sys
import urllib.error
import urllib.request


def main() -> int:
    token = os.environ.get("SECOPSAI_ADMIN_TOKEN")
    if not token:
        print("SECOPSAI_ADMIN_TOKEN is required", file=sys.stderr)
        return 2

    api_url = os.environ.get("SECOPSAI_EDGE_API_URL")
    hostport = os.environ.get("SECOPSAI_EDGE_API_HOSTPORT")
    if not api_url:
        if not hostport:
            print("SECOPSAI_EDGE_API_URL or SECOPSAI_EDGE_API_HOSTPORT is required", file=sys.stderr)
            return 2
        api_url = f"http://{hostport}"

    url = f"{api_url.rstrip('/')}/api/v1/scan-schedules/run-due"
    request = urllib.request.Request(
        url,
        method="POST",
        headers={
            "Authorization": f"Bearer {token}",
            "Content-Type": "application/json",
        },
    )
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            body = response.read().decode("utf-8")
            payload = json.loads(body)
    except urllib.error.HTTPError as exc:
        print(f"Scheduler request failed with HTTP {exc.code}: {exc.read().decode('utf-8')}", file=sys.stderr)
        return 1
    except Exception as exc:
        print(f"Scheduler request failed: {exc}", file=sys.stderr)
        return 1

    print(json.dumps(payload, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
