#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VERSION="${1:-}"
OUTPUT_DIR="${2:-$ROOT_DIR/dist}"

[ -n "$VERSION" ] || { echo "Usage: ./scripts/build-release <version> [output-dir]" >&2; exit 2; }
case "$VERSION" in
  v*) VERSION="${VERSION#v}" ;;
esac

read_committed_python_version() {
  git -C "$ROOT_DIR" show "HEAD:$1" | python3 -c '
import ast
import sys

module = ast.parse(sys.stdin.read())
for statement in module.body:
    if isinstance(statement, ast.Assign):
        for target in statement.targets:
            if isinstance(target, ast.Name) and target.id == "__version__":
                if isinstance(statement.value, ast.Constant) and isinstance(statement.value.value, str):
                    print(statement.value.value)
                    raise SystemExit(0)
raise SystemExit("committed component has no literal __version__")
'
}

api_version="$(read_committed_python_version api/secopsai_api/__init__.py)"
agent_version="$(read_committed_python_version agent/secopsai_agent/__init__.py)"
web_version="$(git -C "$ROOT_DIR" show HEAD:web/package.json | python3 -c 'import json, sys; print(json.load(sys.stdin)["version"])')"
for component in "$api_version" "$agent_version" "$web_version"; do
  [ "$component" = "$VERSION" ] || {
    echo "Release version $VERSION does not match component version $component" >&2
    exit 1
  }
done

mkdir -p "$OUTPUT_DIR"
archive="$OUTPUT_DIR/secopsai-edge-$VERSION.tar.gz"
checksum="$archive.sha256"

git -C "$ROOT_DIR" archive \
  --format=tar.gz \
  --prefix="secopsai-edge-$VERSION/" \
  --output="$archive" \
  HEAD

(
  cd "$OUTPUT_DIR"
  shasum -a 256 "$(basename "$archive")" > "$(basename "$checksum")"
)

git -C "$ROOT_DIR" show HEAD:scripts/bootstrap-secopsai-edge.sh > "$OUTPUT_DIR/bootstrap-secopsai-edge.sh"
chmod 755 "$OUTPUT_DIR/bootstrap-secopsai-edge.sh"
printf "%s\n%s\n" "$archive" "$checksum"
